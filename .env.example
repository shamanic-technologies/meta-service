# Service
PORT=3001
NODE_ENV=development
META_SERVICE_API_KEY=              # service-to-service auth key
META_SERVICE_ENCRYPTION_KEY=       # 64-char hex (32 bytes) for AES-256-GCM token encryption

# Meta App — the per-user OAuth connect path only.
# The MANAGED path holds nothing here: our Business Manager, ad account, page,
# dataset and system-user token are platform keys in key-service, resolved at
# call time by src/lib/key-service.ts. Never put a Meta asset id or token below.
META_APP_ID=                       # Facebook App ID
META_APP_SECRET=                   # Facebook App Secret
META_WEBHOOK_VERIFY_TOKEN=         # Webhook verification token (arbitrary string)

# Database
META_SERVICE_DATABASE_URL=         # Neon Postgres connection string

# Shared Services
KEY_SERVICE_URL=
KEY_SERVICE_API_KEY=
RUNS_SERVICE_URL=
RUNS_SERVICE_API_KEY=
COSTS_SERVICE_URL=
COSTS_SERVICE_API_KEY=
TRANSACTIONAL_EMAIL_SERVICE_URL=
TRANSACTIONAL_EMAIL_SERVICE_API_KEY=
API_REGISTRY_URL=
API_REGISTRY_API_KEY=

# Ad review poll — its OWN cadence, never chained to a launch.
META_REVIEW_INTERVAL_MINUTES=15
META_REVIEW_FIRST_TICK_MINUTES=2

# Meta spend ingestion — its OWN cadence, never chained to a launch.
META_ADS_SPEND_INTERVAL_HOURS=6
META_ADS_SPEND_LOOKBACK_DAYS=7
META_ADS_SPEND_FIRST_TICK_MINUTES=5

# Optional
SENTRY_DSN=
